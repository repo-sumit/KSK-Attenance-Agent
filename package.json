{
  "name": "ksk-attendance",
  "version": "0.1.0",
  "private": true,
  "description": "KSK Attendance MiniApp (Maharashtra) — SwiftChat embedded attendance for ITI instructors and principals",
  "scripts": {
    "predev": "node scripts/vendor-mediapipe.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-mediapipe.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:demo": "node scripts/check-demo-stripped.mjs",
    "voice:spike-token": "node --env-file=.env.development scripts/voice/spike-token.mjs",
    "voice:spike-voices": "node --env-file=.env.development scripts/voice/spike-voices.mjs",
    "test:voice-live": "node --env-file=.env.development ./node_modules/vitest/vitest.mjs run --config vitest.voice-live.config.mts",
    "test:supabase-live": "vitest run --config vitest.supabase-live.config.mts"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9 <27"
  }
}
